      "body": "<!doctype html>\n<html lang=\"es\">\n<head>\n<meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<meta name=\"lex-mex-base\" content=\"/lex-mex/\">\n<meta name=\"description\" content=\"Corpus jur\u00eddico mexicano: art\u00edculos, referencias y sus fuentes oficiales, en una misma consulta.\">\n<link rel=\"describedby\" href=\"./llms.txt\"><link rel=\"stylesheet\" href=\"./reader.css\">\n<link rel=\"icon\" href=\"/favicon-monogram-square.png\" sizes=\"512x512\" type=\"image/png\">\n<link rel=\"shortcut icon\" href=\"/favicon-monogram-square.png\">\n<link rel=\"apple-touch-icon\" href=\"/avatar-dark-512.png\">\n<title>Lex-Mex \u00b7 Corpus jur\u00eddico</title>\n</head>\n<body>\n<a class=\"skip\" href=\"#article\">Ir al art\u00edculo</a>\n<header class=\"topbar\">\n  <a class=\"brand\" href=\"./\" aria-label=\"Lex-Mex inicio\"><span><img src=\"./lex-mex.svg\" width=\"115\" height=\"36\" alt=\"lex-mex\"><small>CORPUS JUR\u00cdDICO</small></span></a>\n  <div class=\"search-wrap\"><span aria-hidden=\"true\">\u2315</span><input id=\"search\" type=\"search\" placeholder=\"Buscar en esta colecci\u00f3n\" aria-label=\"Buscar art\u00edculos en la colecci\u00f3n\" autocomplete=\"off\"><kbd>/</kbd></div>\n  <span class=\"collection-badge\">Colecci\u00f3n financiera \u00b7 parcial</span>\n  <button id=\"about-open\" class=\"about-link\" type=\"button\">About</button>\n  <a class=\"firm-link\" href=\"https://www.leg4ll4bs.com/\">LEG4L L4BS \u2197</a>\n</header>\n<div class=\"workspace\">\n<aside class=\"sidebar\" id=\"index-sheet\" aria-label=\"\u00cdndice del corpus\">\n  <div class=\"sheet-bar\"><p class=\"eyebrow\">INSTRUMENTOS</p><button class=\"quiet sheet-close\" type=\"button\" data-close=\"index-sheet\">Cerrar</button></div><select id=\"instrument\" aria-label=\"Seleccionar instrumento\"></select>\n  <div id=\"instrument-summary\" class=\"instrument-summary\"></div>\n  <button id=\"download-instrument\" class=\
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/R4m1r0qu41/Lex-Mex/schemas/reference-edge.schema.json",
  "title": "Lex-Mex canonical reference edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_provision_id",
    "source_span",
    "start_char",
    "end_char",
    "target_instrument_id",
    "target_provision_id",
    "qualifiers",
    "basis",
    "confidence",
    "resolution_status",
    "reference_form"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_provision_id": {
      "type": "string",
      "minLength": 1
    },
    "source_span": {
      "type": "string",
      "minLength": 1
    },
    "start_char": {
      "type": "integer",
      "minimum": 0
    },
    "end_char": {
      "type": "integer",
      "minimum": 1
    },
    "target_instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "target_provision_id": {
      "type": "string",
      "minLength": 1
    },
    "qualifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "qualifier_type",
          "text"
        ],
        "dependentRequired": {
          "start_char": [
            "end_char"
          ],
          "end_char": [
            "start_char"
          ]
        },
        "properties": {
          "qualifier_type": {
            "type": "string",
            "enum": [
              "paragraph",
              "fraction",
              "subsection",
              "other"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "basis": {
      "type": "string",
      "const": "express_cross_reference"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved",
        "historical_target_unavailable",
        "historical_superseded_reference_outdated"
      ]
    },
    "reference_form": {
      "type": "string",
      "enum": [
        "direct",
        "range_expansion",
        "relative"
      ]
    },
    "resolution_rule": {
      "description": "How the linker chose the target. Absent on edges written before the field existed.",
      "type": "string",
      "enum": [
        "own_instrument_default",
        "own_instrument_marker",
        "named_instrument",
        "parent_shorthand",
        "same_article",
        "relative_position"
      ]
    },
    "outdated_reference_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_provision_id",
        "target_instrument_id",
        "target_provision_id",
        "source_span",
        "reviewer",
        "rationale",
        "decision_source",
        "start_char",
        "end_char",
        "source_text_sha256",
        "source_sha256",
        "captured_at",
        "decision_source_sha256"
      ],
      "properties": {
        "source_provision_id": {
          "type": "string",
          "minLength": 1
        },
        "target_instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "target_provision_id": {
          "type": "string",
          "minLength": 1
        },
        "source_span": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "decision_source": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer_supplied_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "legal_operator_review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Human legal note on one exact citation; never changes the edge's target or resolution status.",
      "required": [
        "source_provision_id",
        "target_instrument_id",
        "target_provision_id",
        "source_span",
        "start_char",
        "end_char",
        "source_text_sha256",
        "reviewer",
        "captured_at",
        "note",
        "decision_source",
        "decision_source_sha256"
      ],
      "properties": {
        "source_provision_id": {
          "type": "string",
          "minLength": 1
        },
        "target_instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "target_provision_id": {
          "type": "string",
          "minLength": 1
        },
        "source_span": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 1
        },
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "decision_source": {
          "type": "string",
          "minLength": 1
        },
        "decision_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resolution_status": {
            "const": "historical_superseded_reference_outdated"
          }
        }
      },
      "then": {
        "required": [
          "outdated_reference_approval"
        ]
      },
      "else": {
        "not": {
          "required": [
            "outdated_reference_approval"
          ]
        }
      }
    }
  ]
}

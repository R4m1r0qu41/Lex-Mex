{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lex-mex.example/schemas/corpus-bundle-manifest.schema.json",
  "title": "Lex-Mex selected corpus bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_schema_version",
    "profile",
    "corpus_commit",
    "generated_at",
    "instruments",
    "excluded_external_target_instrument_ids"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "corpus_schema_version": { "type": "string", "minLength": 1 },
    "profile": {
      "enum": ["canonical", "canonical_markdown"]
    },
    "corpus_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instrument" }
    },
    "excluded_external_target_instrument_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "id",
        "source_sha256",
        "extracted_text_sha256",
        "validation_sha256",
        "files"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "id": { "type": "string", "minLength": 1 },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "extracted_text_sha256": { "$ref": "#/$defs/sha256" },
        "validation_sha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 4,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lex-mex.example/schemas/standard-metadata.schema.json",
  "title": "Lex-Mex NOM/NMX metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "designation",
    "official_title",
    "issuing_authorities",
    "regulatory_domains",
    "publication_date",
    "effective_date",
    "cancellation_date",
    "status",
    "objective",
    "scope",
    "conformity_assessment",
    "text_basis",
    "modifications",
    "systematic_review",
    "source_url",
    "official_dof_url",
    "official_registry_url",
    "publisher",
    "retrieved_at",
    "source_sha256",
    "extracted_text_sha256",
    "parser_version",
    "legal_review_status",
    "technical_review_status"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": {
      "type": "string",
      "pattern": "^urn:lex-mx:federal:(nom|nmx):[a-z0-9-]+$"
    },
    "kind": { "enum": ["nom", "nmx"] },
    "designation": {
      "type": "string",
      "pattern": "^(NOM|NMX)-.+$"
    },
    "published_designation": {
      "type": "string",
      "pattern": "^(NOM|NMX)-.+$"
    },
    "official_title": { "type": "string", "minLength": 1 },
    "issuing_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "regulatory_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "publication_date": { "type": "string", "format": "date" },
    "effective_date": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "cancellation_date": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "status": { "enum": ["current", "cancelled", "replaced", "unknown"] },
    "replaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "replaced_by": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "joint_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "objective": { "type": ["string", "null"] },
    "scope": { "type": ["string", "null"] },
    "conformity_assessment": { "type": ["string", "null"] },
    "text_basis": { "enum": ["as_published", "official_compilation"] },
    "modifications": {
      "type": "array",
      "items": { "$ref": "#/$defs/modification" }
    },
    "systematic_review": {
      "oneOf": [
        { "$ref": "#/$defs/systematic_review" },
        { "type": "null" }
      ]
    },
    "source_url": { "type": "string", "format": "uri" },
    "official_dof_url": { "type": "string", "format": "uri" },
    "official_registry_url": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "publisher": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "extracted_text_sha256": { "$ref": "#/$defs/sha256" },
    "parser_version": { "type": "string", "minLength": 1 },
    "legal_review_status": {
      "enum": ["not_analyzed", "machine_accepted", "review_required", "lawyer_verified"]
    },
    "technical_review_status": {
      "enum": ["not_analyzed", "review_required", "technical_verified"]
    }
  },
  "$defs": {
    "modification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_date", "official_url", "included_in_source"],
      "properties": {
        "publication_date": { "type": "string", "format": "date" },
        "official_url": { "type": "string", "format": "uri" },
        "included_in_source": { "type": "boolean" },
        "title": {
          "description": "The decree's own DOF publication title, verbatim. Pure source-grounded input, never derived: a Mexican modifying decree names the numerals it touches in its own title, which is what locates the affected clauses without reading the decree body. Optional because the form is not universal -- STPS publishes 'ACUERDO de Modificación a la Norma Oficial Mexicana NOM-020-STPS-2011, ...' naming no numeral at all.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "systematic_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_date", "result", "report_url"],
      "properties": {
        "review_date": { "type": "string", "format": "date" },
        "result": { "type": "string", "minLength": 1 },
        "report_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

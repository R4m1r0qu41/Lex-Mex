{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lex-mex.example/schemas/standard-metadata.schema.json",
  "title": "Lex-Mex NOM/NMX metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "designation",
    "official_title",
    "issuing_authorities",
    "regulatory_domains",
    "publication_date",
    "effective_date",
    "cancellation_date",
    "status",
    "objective",
    "scope",
    "conformity_assessment",
    "source_url",
    "official_dof_url",
    "official_registry_url",
    "publisher",
    "retrieved_at",
    "source_sha256",
    "extracted_text_sha256",
    "parser_version",
    "legal_review_status",
    "technical_review_status"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": {
      "type": "string",
      "pattern": "^urn:lex-mx:federal:(nom|nmx):[a-z0-9-]+$"
    },
    "kind": { "enum": ["nom", "nmx"] },
    "designation": {
      "type": "string",
      "pattern": "^(NOM|NMX)-.+$"
    },
    "official_title": { "type": "string", "minLength": 1 },
    "issuing_authorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "regulatory_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "publication_date": { "type": "string", "format": "date" },
    "effective_date": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "cancellation_date": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "status": { "enum": ["current", "cancelled", "replaced", "unknown"] },
    "replaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "replaced_by": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "joint_prefixes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "objective": { "type": ["string", "null"] },
    "scope": { "type": ["string", "null"] },
    "conformity_assessment": { "type": ["string", "null"] },
    "source_url": { "type": "string", "format": "uri" },
    "official_dof_url": { "type": "string", "format": "uri" },
    "official_registry_url": {
      "oneOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "publisher": { "type": "string", "minLength": 1 },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "extracted_text_sha256": { "$ref": "#/$defs/sha256" },
    "parser_version": { "type": "string", "minLength": 1 },
    "legal_review_status": {
      "enum": ["not_analyzed", "machine_accepted", "review_required", "lawyer_verified"]
    },
    "technical_review_status": {
      "enum": ["not_analyzed", "review_required", "technical_verified"]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

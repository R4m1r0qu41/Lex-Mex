{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_corpus_commit",
    "decision_source_path",
    "decision_source_sha256",
    "rows",
    "review_source_path",
    "review_source_sha256",
    "decision_sections"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2",
        "3"
      ]
    },
    "source_corpus_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "decision_source_path": {
      "type": "string"
    },
    "decision_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/debt_row"
      }
    },
    "review_source_path": {
      "type": "string",
      "minLength": 1
    },
    "review_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "heading",
          "sha256"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "heading": {
            "type": "string",
            "pattern": "^## "
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "retirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "resolved_at_commit",
          "provision_id",
          "source_path",
          "source_blob_oid",
          "source_sha256"
        ],
        "properties": {
          "row": {
            "$ref": "#/$defs/debt_row"
          },
          "resolved_at_commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "provision_id": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_blob_oid": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "debt_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrument_id",
        "kind",
        "printed_label",
        "heading_text",
        "containing_provision_id",
        "start_char",
        "end_char",
        "source_path",
        "source_blob_oid",
        "source_sha256",
        "review_status",
        "reviewer",
        "reviewed_at",
        "decision_reference"
      ],
      "properties": {
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "merged_heading"
        },
        "printed_label": {
          "type": "string",
          "minLength": 1
        },
        "heading_text": {
          "type": "string",
          "minLength": 1
        },
        "containing_provision_id": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_blob_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_status": {
          "const": "accepted"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1
        },
        "decision_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "3"
          }
        }
      },
      "then": {
        "required": [
          "retirements"
        ]
      },
      "else": {
        "not": {
          "required": [
            "retirements"
          ]
        }
      }
    }
  ]
}

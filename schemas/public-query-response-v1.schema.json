{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public query response v1",
  "description": "Closed public projection served by the bound read-only adapter. No raw database rows, internal paths, reviewer identities or private rationales are representable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "outcome", "snapshot", "result"],
  "properties": {
    "schema_version": {"const": "public-query-response-v1"},
    "operation": {"enum": [null, "coverage", "resolve", "search", "get_provision", "references"]},
    "outcome": {"enum": ["ok", "found", "ambiguous", "not_found", "outside_published_scope", "oversized", "release_unavailable", "client_error", "unavailable"]},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/coverage"},
        {"$ref": "#/$defs/resolution"},
        {"$ref": "#/$defs/absence"},
        {"$ref": "#/$defs/outside_scope"},
        {"$ref": "#/$defs/provision_result"},
        {"$ref": "#/$defs/oversized_provision"},
        {"$ref": "#/$defs/search"},
        {"$ref": "#/$defs/references"},
        {"$ref": "#/$defs/release_unavailable"},
        {"$ref": "#/$defs/error"}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "ok"}}}, "then": {"properties": {"result": {"properties": {"kind": {"enum": ["coverage", "search", "references"]}}}}}},
    {"if": {"properties": {"outcome": {"const": "found"}}}, "then": {"properties": {"result": {"properties": {"kind": {"enum": ["resolution", "provision"]}}}}}},
    {"if": {"properties": {"outcome": {"const": "ambiguous"}}}, "then": {"properties": {"result": {"properties": {"kind": {"const": "resolution"}}}}}},
    {"if": {"properties": {"outcome": {"const": "not_found"}}}, "then": {"properties": {"result": {"properties": {"kind": {"const": "absence"}}}}}},
    {"if": {"properties": {"outcome": {"const": "outside_published_scope"}}}, "then": {"properties": {"result": {"properties": {"kind": {"const": "outside_scope"}}}}}},
    {"if": {"properties": {"outcome": {"const": "oversized"}}}, "then": {"properties": {"result": {"properties": {"kind": {"const": "oversized_provision"}}}}}},
    {"if": {"properties": {"outcome": {"const": "release_unavailable"}}}, "then": {"properties": {"result": {"properties": {"kind": {"const": "release_unavailable"}}}}}},
    {"if": {"properties": {"outcome": {"enum": ["client_error", "unavailable"]}}}, "then": {"properties": {"result": {"properties": {"kind": {"const": "error"}}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "date": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}]},
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "count": {"type": "integer", "minimum": 0},
    "provision_type": {"enum": ["article", "transitory", "annex"]},
    "cursor": {"anyOf": [{"type": "null"}, {"type": "string", "maxLength": 1024, "pattern": "^[A-Za-z0-9_-]+$"}]},
    "message": {"type": "string", "maxLength": 512},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_release_id", "public_release_corpus_commit", "public_release_manifest_sha256", "database_release_id", "database_sha256", "database_corpus_commit", "projection_version", "coverage", "notice"],
      "properties": {
        "public_release_id": {"$ref": "#/$defs/sha256"},
        "public_release_corpus_commit": {"$ref": "#/$defs/commit"},
        "public_release_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "database_release_id": {"$ref": "#/$defs/sha256"},
        "database_sha256": {"$ref": "#/$defs/sha256"},
        "database_corpus_commit": {"$ref": "#/$defs/commit"},
        "projection_version": {"const": "public-query-v1"},
        "coverage": {"const": "selected_partial"},
        "notice": {"$ref": "#/$defs/message"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "extracted_text_sha256", "publisher", "official_url", "retrieved_at", "parser_version", "schema_version"],
      "properties": {
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "extracted_text_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "publisher": {"type": "string", "maxLength": 512},
        "official_url": {"type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s@]+$"},
        "retrieved_at": {"type": "string", "maxLength": 80},
        "parser_version": {"type": "string", "maxLength": 32},
        "schema_version": {"type": "string", "maxLength": 32}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_path", "text_path", "markdown_path"],
      "properties": {
        "base_path": {"type": "string", "pattern": "^/([A-Za-z0-9_-]+/)*$"},
        "text_path": {"type": "string", "pattern": "^releases/[a-f0-9]{64}/mx/[a-z0-9-]+/provision-[a-f0-9]{64}\\.txt$"},
        "markdown_path": {"type": "string", "pattern": "^releases/[a-f0-9]{64}/mx/[a-z0-9-]+/provision-[a-f0-9]{64}\\.md$"}
      }
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "id", "official_title", "short_name", "publication_date", "latest_reform_date", "provision_count", "reference_count", "source", "index_path", "coverage"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "id": {"$ref": "#/$defs/id"},
        "official_title": {"type": "string", "maxLength": 1024},
        "short_name": {"type": "string", "maxLength": 80},
        "publication_date": {"$ref": "#/$defs/date"},
        "latest_reform_date": {"$ref": "#/$defs/date"},
        "provision_count": {"$ref": "#/$defs/count"},
        "reference_count": {"$ref": "#/$defs/count"},
        "source": {"$ref": "#/$defs/source"},
        "index_path": {"type": "string", "pattern": "^releases/[a-f0-9]{64}/mx/[a-z0-9-]+/index\\.md$"},
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structured", "references", "historical_validity"],
          "properties": {
            "structured": {"const": true},
            "references": {"const": "express_with_disclosed_unresolved_targets"},
            "historical_validity": {"const": "not_established"}
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "instrument_count", "limits", "operations", "items", "next_cursor"],
      "properties": {
        "kind": {"const": "coverage"},
        "scope": {"const": "selected_partial"},
        "instrument_count": {"$ref": "#/$defs/count"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page_size", "excerpt_chars", "query_chars", "query_bytes", "response_bytes", "provision_text_bytes", "deadline_ms"],
          "properties": {
            "page_size": {"$ref": "#/$defs/count"},
            "excerpt_chars": {"$ref": "#/$defs/count"},
            "query_chars": {"$ref": "#/$defs/count"},
            "query_bytes": {"$ref": "#/$defs/count"},
            "response_bytes": {"$ref": "#/$defs/count"},
            "provision_text_bytes": {"$ref": "#/$defs/count"},
            "deadline_ms": {"$ref": "#/$defs/count"}
          }
        },
        "operations": {"type": "array", "items": {"enum": ["coverage", "resolve", "search", "get_provision", "references"]}},
        "items": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/instrument"}},
        "next_cursor": {"$ref": "#/$defs/cursor"}
      }
    },
    "locator_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument", "kind", "locator"],
      "properties": {
        "instrument": {"$ref": "#/$defs/slug"},
        "kind": {"$ref": "#/$defs/provision_type"},
        "locator": {"type": "string", "maxLength": 320}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested", "candidate_count", "candidates", "truncated"],
      "properties": {
        "kind": {"const": "resolution"},
        "requested": {"$ref": "#/$defs/locator_request"},
        "candidate_count": {"type": "integer", "minimum": 1},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "number", "label", "heading_title", "artifacts"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "number": {"type": "string", "maxLength": 160},
              "label": {"type": "string", "maxLength": 320},
              "heading_title": {"type": "string", "maxLength": 2048},
              "artifacts": {"$ref": "#/$defs/artifacts"}
            }
          }
        },
        "truncated": {"type": "boolean"}
      }
    },
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested", "qualifications", "coverage", "message"],
      "properties": {
        "kind": {"const": "absence"},
        "requested": {
          "oneOf": [
            {"$ref": "#/$defs/locator_request"},
            {"type": "object", "additionalProperties": false, "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}}
          ]
        },
        "qualifications": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "printed_label", "containing_provision_id", "start_char", "end_char"],
                "properties": {
                  "kind": {"const": "not_separately_parsed"},
                  "printed_label": {"type": "string", "maxLength": 160},
                  "containing_provision_id": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
                  "start_char": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]},
                  "end_char": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/count"}]}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "citing_instrument_id", "multiplicity"],
                "properties": {
                  "kind": {"const": "cited_not_in_corpus"},
                  "citing_instrument_id": {"$ref": "#/$defs/id"},
                  "multiplicity": {"type": "integer", "minimum": 1}
                }
              }
            ]
          }
        },
        "coverage": {"const": "not_established"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "outside_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested_id", "message"],
      "properties": {
        "kind": {"const": "outside_scope"},
        "requested_id": {"$ref": "#/$defs/id"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "provision_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provision"],
      "properties": {
        "kind": {"const": "provision"},
        "provision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "number", "provision_type", "heading_context", "text", "text_sha256", "text_bytes", "text_chars", "publication_date", "effective_from", "effective_to", "temporal_status", "temporal_basis", "review_status", "repeals", "commencement_condition", "classification_notice", "source", "instrument", "artifacts"],
          "properties": {
            "id": {"$ref": "#/$defs/id"},
            "label": {"type": "string", "maxLength": 320},
            "number": {"type": "string", "maxLength": 160},
            "provision_type": {"$ref": "#/$defs/provision_type"},
            "heading_context": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "libro": {"type": ["string", "null"]},
                "title": {"type": ["string", "null"]},
                "chapter": {"type": ["string", "null"]},
                "section": {"type": ["string", "null"]},
                "apartado": {"type": ["string", "null"]}
              }
            },
            "text": {"type": "string"},
            "text_sha256": {"$ref": "#/$defs/sha256"},
            "text_bytes": {"$ref": "#/$defs/count"},
            "text_chars": {"$ref": "#/$defs/count"},
            "publication_date": {"$ref": "#/$defs/date"},
            "effective_from": {"$ref": "#/$defs/date"},
            "effective_to": {"$ref": "#/$defs/date"},
            "temporal_status": {"type": "string", "maxLength": 64},
            "temporal_basis": {"type": ["string", "null"], "maxLength": 64},
            "review_status": {"type": "string", "maxLength": 64},
            "repeals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scope", "ordinals", "cause", "renumbering"],
                "properties": {
                  "scope": {"type": "string", "maxLength": 64},
                  "ordinals": {"type": "array", "items": {"type": "string", "maxLength": 64}},
                  "cause": {"type": "string", "maxLength": 64},
                  "dof_date": {"$ref": "#/$defs/date"},
                  "renumbering": {"type": "boolean"}
                }
              }
            },
            "commencement_condition": {
              "anyOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_provision_id", "condition_text", "authority", "condition_status", "met_on"],
                  "properties": {
                    "source_provision_id": {"$ref": "#/$defs/id"},
                    "condition_text": {"type": "string"},
                    "authority": {"type": ["string", "null"]},
                    "condition_status": {"type": "string", "maxLength": 64},
                    "met_on": {"$ref": "#/$defs/date"}
                  }
                }
              ]
            },
            "classification_notice": {"$ref": "#/$defs/message"},
            "source": {"$ref": "#/$defs/source"},
            "instrument": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "id", "short_name", "official_title"],
              "properties": {
                "slug": {"$ref": "#/$defs/slug"},
                "id": {"$ref": "#/$defs/id"},
                "short_name": {"type": "string", "maxLength": 80},
                "official_title": {"type": "string", "maxLength": 1024}
              }
            },
            "artifacts": {"$ref": "#/$defs/artifacts"}
          }
        }
      }
    },
    "oversized_provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "label", "text_sha256", "text_bytes", "limit_bytes", "artifacts", "message"],
      "properties": {
        "kind": {"const": "oversized_provision"},
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "maxLength": 320},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "text_bytes": {"$ref": "#/$defs/count"},
        "limit_bytes": {"$ref": "#/$defs/count"},
        "artifacts": {"$ref": "#/$defs/artifacts"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "query", "instrument", "provision_type", "semantics", "items", "next_cursor"],
      "properties": {
        "kind": {"const": "search"},
        "query": {"type": "string", "minLength": 1, "maxLength": 512},
        "instrument": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/slug"}]},
        "provision_type": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/provision_type"}]},
        "semantics": {"const": "literal_phrase_accent_insensitive"},
        "items": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "instrument", "provision_type", "number", "label", "excerpt", "match_location", "text_sha256", "artifacts"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "instrument": {
                "type": "object",
                "additionalProperties": false,
                "required": ["slug", "short_name"],
                "properties": {"slug": {"$ref": "#/$defs/slug"}, "short_name": {"type": "string", "maxLength": 80}}
              },
              "provision_type": {"$ref": "#/$defs/provision_type"},
              "number": {"type": "string", "maxLength": 160},
              "label": {"type": "string", "maxLength": 320},
              "excerpt": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "start_char", "end_char", "text_chars", "partial"],
                "properties": {
                  "text": {"type": "string", "maxLength": 240},
                  "start_char": {"$ref": "#/$defs/count"},
                  "end_char": {"$ref": "#/$defs/count"},
                  "text_chars": {"$ref": "#/$defs/count"},
                  "partial": {"type": "boolean"}
                }
              },
              "match_location": {"enum": ["text", "label_or_heading"]},
              "text_sha256": {"$ref": "#/$defs/sha256"},
              "artifacts": {"$ref": "#/$defs/artifacts"}
            }
          }
        },
        "next_cursor": {"$ref": "#/$defs/cursor"}
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "direction", "scope_notice", "items", "next_cursor"],
      "properties": {
        "kind": {"const": "references"},
        "id": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["outgoing", "incoming"]},
        "scope_notice": {"$ref": "#/$defs/message"},
        "items": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source_id", "source_kind", "source_span", "start_char", "end_char", "target_instrument_id", "target_provision_id", "resolution_status", "resolution_rule", "reference_form", "basis", "qualifiers", "target_availability"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "source_id": {"$ref": "#/$defs/id"},
              "source_kind": {"enum": ["provision", "instrument_title"]},
              "source_span": {"type": "string", "maxLength": 1024},
              "start_char": {"$ref": "#/$defs/count"},
              "end_char": {"$ref": "#/$defs/count"},
              "target_instrument_id": {"$ref": "#/$defs/id"},
              "target_provision_id": {"$ref": "#/$defs/id"},
              "resolution_status": {"enum": ["resolved", "unresolved", "historical_target_unavailable", "historical_superseded_reference_outdated"]},
              "resolution_rule": {"type": ["string", "null"], "maxLength": 80},
              "reference_form": {"type": "string", "maxLength": 64},
              "basis": {"type": "string", "maxLength": 64},
              "qualifiers": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["qualifier_type", "text", "start_char", "end_char"],
                  "properties": {
                    "qualifier_type": {"type": "string", "maxLength": 64},
                    "text": {"type": "string", "maxLength": 512},
                    "start_char": {"$ref": "#/$defs/count"},
                    "end_char": {"$ref": "#/$defs/count"}
                  }
                }
              },
              "target_availability": {"enum": ["published", "outside_published_scope", "unresolved", "historical"]}
            }
          }
        },
        "next_cursor": {"$ref": "#/$defs/cursor"}
      }
    },
    "release_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requested_release_id", "message"],
      "properties": {
        "kind": {"const": "release_unavailable"},
        "requested_release_id": {"$ref": "#/$defs/sha256"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "message"],
      "properties": {
        "kind": {"const": "error"},
        "code": {"enum": ["bad_request", "unknown_instrument", "invalid_locator", "invalid_query", "empty_query", "query_too_long", "invalid_cursor", "cursor_release_mismatch", "cursor_request_mismatch", "as_of_not_supported", "response_too_large", "deadline_exceeded", "internal_error", "contract_violation"]},
        "message": {"$ref": "#/$defs/message"}
      }
    }
  }
}
